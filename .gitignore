runs/verifier/rgb_v4/*/eval_curve_*.csv
runs/verifier/rgb_v4/*/eval_ops_*.json

# Per-run GUI pipeline outputs (regenerable via sidebar Step 3)
runs/verifier/pipeline_*/
outputs/web/fusion_detections_pipeline_*.jsonl
outputs/web/fusion_manifest_pipeline_*.json
outputs/confusion_matrices_pipeline_*.png

# Output media (large, regenerable)
outputs/videos/
outputs/*.mp4
outputs/*.gif

